# ── Domaine public (Caddy / docker-compose) ─────────────────────────────
MCP_DOMAIN=mcp.example.com
MCP_PUBLIC_URL=https://mcp.example.com

# ── Authentification des clients MCP ────────────────────────────────────
# oauth : chaque utilisateur se connecte avec son compte BIMData (connecteur Claude.ai / Desktop).
# token : jeton(s) Bearer statique(s) + identifiants BIMData du serveur (API Claude, Claude Code).
# none  : développement local uniquement (refusé en production).
MCP_AUTH_MODE=oauth

# Mode oauth — application créée sur https://connect.bimdata.io (« Manage your applications »)
#   type confidentiel, redirect URI : https://<MCP_DOMAIN>/auth/callback
BIMDATA_OAUTH_CLIENT_ID=
BIMDATA_OAUTH_CLIENT_SECRET=
BIMDATA_OAUTH_SCOPES=openid
# Clé stable (≥ 32 caractères aléatoires) : signe les jetons émis vers Claude et chiffre leur stockage.
MCP_JWT_SIGNING_KEY=

# Mode token — jetons acceptés (séparés par des virgules) + accès BIMData du serveur
MCP_API_TOKENS=
BIMDATA_API_KEY=
# ou flux client_credentials :
BIMDATA_CLIENT_ID=
BIMDATA_CLIENT_SECRET=

# ── Fichiers ────────────────────────────────────────────────────────────
# Secret HMAC des liens de téléchargement / dépôt (≥ 32 caractères aléatoires).
MCP_FILE_SECRET=
MCP_FILE_LINK_TTL=86400
MCP_UPLOAD_LINK_TTL=7200
MCP_MAX_UPLOAD_MB=50

# ── Comportement ────────────────────────────────────────────────────────
# false = serveur en lecture seule (aucune Smart View, BCF ni correction écrite).
MCP_ALLOW_WRITES=true
MCP_MAX_PLAN_ITEMS=20000

# ── API BIMData (valeurs par défaut) ────────────────────────────────────
BIMDATA_API_URL=https://api.bimdata.io
BIMDATA_PLATFORM_URL=https://platform.bimdata.io
BIMDATA_IAM_REALM_URL=https://iam.bimdata.io/auth/realms/bimdata
